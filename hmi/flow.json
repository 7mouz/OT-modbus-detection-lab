    {
        "id": "628b5be3df88ca61",
        "type": "ui-template",
        "z": "d75fc83f31c26b04",
        "group": "ddc1767d96cf9feb",
        "page": "",
        "ui": "",
        "name": "",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"scada\">\n    <div class=\"ttl\">Milk Pasteurizer</div>\n    <svg viewBox=\"0 0 440 300\" class=\"mimic\">\n      <defs>\n        <linearGradient id=\"steel\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n          <stop offset=\"0\" stop-color=\"#828a91\" />\n          <stop offset=\"0.35\" stop-color=\"#eef1f3\" />\n          <stop offset=\"0.62\" stop-color=\"#dbe0e4\" />\n          <stop offset=\"1\" stop-color=\"#757d84\" />\n        </linearGradient>\n        <clipPath id=\"vat\">\n          <rect x=\"150\" y=\"70\" width=\"90\" height=\"150\" />\n        </clipPath>\n      </defs>\n\n      <!-- inlet pipe + pump valve -->\n      <path d=\"M118,40 H195 V70\" class=\"pipe\" />\n      <rect x=\"110\" y=\"33\" width=\"14\" height=\"14\" :class=\"['valve', t.pump?'on':'off']\" />\n      <text x=\"117\" y=\"28\" class=\"lbl\" text-anchor=\"middle\">PUMP</text>\n\n      <!-- vessel (shaded cylinder) -->\n      <ellipse cx=\"195\" cy=\"70\" rx=\"45\" ry=\"10\" fill=\"url(#steel)\" stroke=\"#5b636a\" />\n      <rect x=\"150\" y=\"70\" width=\"90\" height=\"150\" fill=\"url(#steel)\" stroke=\"#5b636a\" />\n      <rect :y=\"220 - t.level*1.5\" x=\"150\" width=\"90\" :height=\"t.level*1.5\" fill=\"#3d9be0\" opacity=\"0.8\"\n        clip-path=\"url(#vat)\" />\n      <line v-if=\"t.lsp\" x1=\"150\" :y1=\"220 - t.lsp*1.5\" x2=\"242\" :y2=\"220 - t.lsp*1.5\" stroke=\"#c0392b\"\n        stroke-dasharray=\"4 3\" />\n      <ellipse cx=\"195\" cy=\"220\" rx=\"45\" ry=\"10\" fill=\"url(#steel)\" stroke=\"#5b636a\" />\n\n      <!-- inline readouts, P&ID style -->\n      <text x=\"195\" y=\"150\" text-anchor=\"middle\" class=\"rd big\" :fill=\"tcolor\">{{ Math.round(t.temp) }}\u00b0C</text>\n      <text x=\"252\" y=\"92\" class=\"rd red\">SP {{ t.tsp }}\u00b0C</text>\n      <text x=\"252\" y=\"120\" class=\"rd blue\">{{ t.level }} %</text><text x=\"252\" y=\"132\" class=\"lbl\">level</text>\n      <text x=\"252\" y=\"162\" class=\"rd amber\">{{ t.power }} %</text><text x=\"252\" y=\"174\" class=\"lbl\">heat</text>\n\n      <!-- discharge pipe + valve -->\n      <path d=\"M195,230 V265 H300\" class=\"pipe\" />\n      <rect x=\"188\" y=\"258\" width=\"14\" height=\"14\" :class=\"['valve', t.discharge?'on':'off']\" />\n      <text x=\"316\" y=\"269\" class=\"lbl\" text-anchor=\"start\">DISCHARGE</text>\n      <text x=\"316\" y=\"258\" class=\"run\" v-if=\"t.discharge\">\u25b6 to containers</text>\n\n      <!-- batch status lamp -->\n      <rect x=\"20\" y=\"60\" width=\"108\" height=\"34\" rx=\"2\" :fill=\"t.batchsafe?'#1e7d32':'#8a2020'\" stroke=\"#333\" />\n      <text x=\"74\" y=\"79\" text-anchor=\"middle\" class=\"status\">{{ t.batchsafe?'BATCH SAFE':'DIVERT' }}</text>\n      <text x=\"74\" y=\"90\" text-anchor=\"middle\" class=\"statlbl\">{{ t.batchsafe?'safe to release':'not pasteurized'\n        }}</text>\n\n      <!-- pasteurization hold progress -->\n      <text x=\"20\" y=\"107\" class=\"lbl\">PASTEURIZATION HOLD</text>\n      <rect x=\"20\" y=\"112\" width=\"108\" height=\"10\" rx=\"2\" fill=\"#c3ccd2\" stroke=\"#8a9299\" />\n      <rect x=\"20\" y=\"112\" :width=\"Math.min(t.hold,30)/30*108\" height=\"10\" rx=\"2\"\n        :fill=\"t.batchsafe ? '#1e7d32' : '#1f6fb0'\" />\n      <text x=\"74\" y=\"134\" text-anchor=\"middle\" class=\"lbl\">{{ t.hold }} / 30 s</text>\n\n      <!-- alarm annunciator -->\n      <text x=\"20\" y=\"150\" class=\"alm\" :class=\"{lit:t.almlow}\">\u25cf LOW LEVEL</text>\n      <text x=\"20\" y=\"168\" class=\"alm\" :class=\"{lit:t.almhigh}\">\u25cf HIGH LEVEL</text>\n      <text x=\"20\" y=\"186\" class=\"alm\" :class=\"{lit:t.almpast}\">\u25cf UNDER TEMP</text>\n      <text x=\"20\" y=\"204\" class=\"alm\" :class=\"{lit:t.almhot}\">\u25cf OVER TEMP</text>\n      </svg>\n  </div>\n</template>\n\n<script>\n  export default {\n    data() {\n      return { t: { temp:0, level:0, tsp:0, lsp:0, power:0, hold:0,\n      heater:false, pump:false, discharge:false, batchsafe:false,\n      almlow:false, almhigh:false, almpast:false, almhot:false } }\n    },\n    computed: {\n      tcolor() { return this.t.almhot ? '#c0392b' : (this.t.temp>=63 ? '#1e7d32' : '#1f6fb0') }\n    },\n          watch: {\n          msg(m) {\n          if (m && m.topic !== undefined)\n          this.t[m.topic] = Array.isArray(m.payload) ? m.payload[0] : m.payload\n          }\n          }\n  }\n</script>\n\n<style>\n  .scada {\n    background: #d7dde1;\n    padding: 8px;\n    border-radius: 3px;\n    font-family: 'Segoe UI', system-ui, sans-serif;\n  }\n  .alm { fill:#9aa4ab; font-size:12px; font-weight:700; } /* grayed when clear */\n  .alm.lit { fill:#c0392b; } /* red when active */\n  .ttl {\n    text-align: center;\n    color: #2a3a47;\n    font-size: 14px;\n    font-weight: 600;\n    margin-bottom: 4px;\n  }\n\n  .mimic {\n    width: 100%;\n    height: auto;\n  }\n\n  .pipe {\n    stroke: #8a9299;\n    stroke-width: 5;\n    fill: none;\n  }\n\n  .valve.on {\n    fill: #2ecc71;\n    stroke: #1a7a43;\n  }\n\n  .valve.off {\n    fill: #9aa4ab;\n    stroke: #5b636a;\n  }\n\n  text.rd {\n    font-size: 13px;\n    font-weight: 600;\n    fill: #25405a;\n  }\n\n  text.rd.big {\n    font-size: 21px;\n    font-weight: 700;\n  }\n\n  .rd.blue {\n    fill: #1f6fb0;\n  }\n\n  .rd.amber {\n    fill: #b8791a;\n  }\n\n  .rd.red {\n    fill: #c0392b;\n  }\n\n  .lbl {\n    font-size: 9px;\n    fill: #5a6a76;\n  }\n\n  .run {\n    font-size: 10px;\n    fill: #1e7d32;\n    font-weight: 600;\n  }\n\n  .status {\n    fill: #fff;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .statlbl {\n    fill: #e8e8e8;\n    font-size: 8px;\n  }\n\n  \n</style>",
